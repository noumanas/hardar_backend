# ── App ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Comma-separated origins allowed to call the API (admin dashboard, website)
CORS_ORIGINS=http://localhost:3001

# ── Database ─────────────────────────────────────────────────────────
DATABASE_URL=postgres://USER@localhost:5432/haqdar
DATABASE_SSL=false
DATABASE_LOGGING=false

# ── Security ─────────────────────────────────────────────────────────
# 32 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# At least 32 characters:   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HASH_SECRET=
# Sent as the x-api-key header on /admin endpoints (at least 24 characters)
ADMIN_API_KEY=

# ── Rate limits ──────────────────────────────────────────────────────
# Redis shares rate-limit counters across servers (required for more than one server)
REDIS_URL=redis://localhost:6379
# Number of proxies/CDNs in front of the app (0 when the app is reached directly)
TRUST_PROXY_HOPS=0
# Public demo: AI requests per hour for all visitors together (the Gemini cost ceiling)
DEMO_AI_HOURLY_BUDGET=600
DEMO_SPEECH_HOURLY_BUDGET=600
DEMO_CONTRACT_HOURLY_BUDGET=200

# ── Agent (Gemini) ───────────────────────────────────────────────────
# gemini | none  (none, or no key: agent replies fall back to the MOHRE helpline message)
AGENT_LLM_PROVIDER=gemini
# Google AI Studio key: https://aistudio.google.com/apikey  (required in production)
GEMINI_API_KEY=
AGENT_MODEL=gemini-3.8-flash
# Spoken replies (website demo): Gemini TTS model and one of its prebuilt voices
AGENT_TTS_MODEL=gemini-3.8-flash-tts
AGENT_TTS_VOICE=Kore
# low | medium | high  (low keeps voice replies under the PRD's 15 s target)
AGENT_THINKING_LEVEL=low
AGENT_MAX_TOOL_ROUNDS=6
CONVERSATION_HISTORY_LIMIT=12

# ── WhatsApp Cloud API ───────────────────────────────────────────────
# Leave the token and phone number id empty in development: replies are logged instead of sent.
WHATSAPP_API_VERSION=v23.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Required in production: verifies the X-Hub-Signature-256 header on webhooks
WHATSAPP_APP_SECRET=
# Any string; must match the "Verify token" set in the Meta app dashboard
WHATSAPP_VERIFY_TOKEN=
# Approved template for follow-ups sent outside the 24-hour window (optional)
WHATSAPP_FOLLOW_UP_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=ur
